[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://demo/demo.gd" id="1_demo"]
[ext_resource type="Script" path="res://addons/gdmarkdown/markdown_label.gd" id="2_label"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_sidebar"]
bg_color = Color(0.13, 0.14, 0.18, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_preview"]
bg_color = Color(0.11, 0.12, 0.16, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="Demo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.09, 0.1, 0.13, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "gdmarkdown"

[node name="Subtitle" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.56, 0.59, 0.66, 1)
text = "Markdown in a RichTextLabel"

[node name="StyleLabel" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.56, 0.59, 0.66, 1)
text = "Style"

[node name="StylePicker" type="OptionButton" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2

[node name="Body" type="HSplitContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 190
theme_override_constants/separation = 14

[node name="Sidebar" type="PanelContainer" parent="Margin/Layout/Body"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_sidebar")

[node name="SidebarMargin" type="MarginContainer" parent="Margin/Layout/Body/Sidebar"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="DocumentList" type="ItemList" parent="Margin/Layout/Body/Sidebar/SidebarMargin"]
layout_mode = 2
theme_override_constants/v_separation = 6
allow_reselect = true

[node name="PreviewPanel" type="PanelContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_preview")

[node name="PreviewMargin" type="MarginContainer" parent="Margin/Layout/Body/PreviewPanel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout/Body/PreviewPanel/PreviewMargin"]
layout_mode = 2
