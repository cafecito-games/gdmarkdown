{
  "version": 1,
  "source_roots": [
    "addons/gdmarkdown",
    "demo",
    "tests"
  ],
  "exclude": [
    ".git/**",
    ".godot/**",
    ".gdkit/**",
    "addons/gdtest/**"
  ],
  "function-name": "(_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*(__[a-z0-9]+)?)",
  "class-name": "([A-Z][a-z0-9]*)+",
  "sub-class-name": "_?([A-Z][a-z0-9]*)+",
  "signal-name": "[a-z][a-z0-9]*(_[a-z0-9]+)*",
  "class-variable-name": "_?[a-z][a-z0-9]*(_[a-z0-9]+)*",
  "class-load-variable-name": "(([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)",
  "function-variable-name": "[a-z][a-z0-9]*(_[a-z0-9]+)*",
  "function-preload-variable-name": "([A-Z][a-z0-9]*)+",
  "function-argument-name": "_?[a-z][a-z0-9]*(_[a-z0-9]+)*",
  "loop-variable-name": "_?[a-z][a-z0-9]*(_[a-z0-9]+)*",
  "enum-name": "([A-Z][a-z0-9]*)+",
  "enum-element-name": "[A-Z][A-Z0-9]*(_[A-Z0-9]+)*",
  "constant-name": "_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*",
  "load-constant-name": "(([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)",
  "max-returns": 12,
  "max-public-methods": 25,
  "function-arguments-number": 10,
  "max-file-lines": 1500,
  "max-line-length": 120,
  "tab-characters": 1,
  "class-definitions-order": [
    "tools",
    "classnames",
    "extends",
    "docstrings",
    "signals",
    "enums",
    "consts",
    "staticvars",
    "exports",
    "pubvars",
    "prvvars",
    "onreadypubvars",
    "onreadyprvvars",
    "others"
  ],
  "missing-docstring": [],
  "no-engine-logging": {
    "functions": [
      "OS.alert",
      "print",
      "print_debug",
      "print_rich",
      "print_stack",
      "printerr",
      "printraw",
      "prints",
      "printt",
      "push_error",
      "push_warning"
    ]
  },
  "enable": [
    "require-return-type",
    "require-argument-type",
    "require-variable-type",
    "require-typed-collection",
    "require-signal-argument-type",
    "require-typed-loop-variable",
    "inconsistent-return-statements",
    "unused-private-member"
  ]
}
