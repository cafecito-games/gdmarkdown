{
  "version": 1,
  "source_roots": [
    "addons/gdmarkdown",
    "demo",
    "tests"
  ],
  "exclude": [
    ".git/**",
    ".godot/**",
    ".gdkit/**",
    "addons/gdtest/**"
  ],
  "line_width": 100,
  "tab_width": 4,
  "indent": "tabs",
  "quote_style": "double",
  "comment_spacing": "normalize",
  "operators": "words",
  "numbers": "normalize",
  "trailing_commas": "when-broken",
  "blank_lines": {
    "top_level": 2,
    "nested": 1
  }
}
